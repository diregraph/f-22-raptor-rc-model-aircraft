# F-35B VTOL model: ArduPlane 4.7 QuadPlane parameters. Loaded on the real board AND in simulation.
# Simulation-only overrides live in sitl.parm. Tuned values are written back here after each SITL tuning run.
#
# Outputs                        function
#  1  left all-moving tail       77 elevon left
#  2  right all-moving tail      78 elevon right
#  5  lift fan ESC               33 motor 1
#  6  main fan ESC               34 motor 2 (tilts with the nozzle)
#  7  left roll fan ESC          35 motor 3
#  8  right roll fan ESC         36 motor 4
#  9  nozzle tilt demand         41 motor tilt (internal: read by f35b_nozzle.lua, no servo plugged in)
# 10  nozzle board, deflection   94 script 1 (1000-2000 us = 0-100 deg)
# 11  nozzle board, yaw swing   95 script 2 (1000-2000 us = -20..+20 deg)
# 12  landing gear (3 servos)    29 landing gear

Q_ENABLE        1
Q_FRAME_CLASS   15
Q_FRAME_TYPE    0
SCR_ENABLE      1
SCR_HEAP_SIZE   100000

# the nozzle is the only thing that tilts: continuous tilt on motor 2
Q_TILT_ENABLE   1
Q_TILT_MASK     2
Q_TILT_TYPE     0
Q_TILT_MAX      65
Q_TILT_RATE_UP  40
Q_TILT_RATE_DN  20

SERVO1_FUNCTION 77
SERVO2_FUNCTION 78
SERVO3_FUNCTION 0
SERVO4_FUNCTION 0
SERVO5_FUNCTION 33
SERVO6_FUNCTION 34
SERVO7_FUNCTION 35
SERVO8_FUNCTION 36
SERVO9_FUNCTION 41
SERVO10_FUNCTION 94
SERVO11_FUNCTION 95
SERVO12_FUNCTION 29

# hover motors
Q_M_PWM_TYPE    0
Q_M_PWM_MIN     1000
Q_M_PWM_MAX     2000
Q_M_THST_EXPO   0.65
Q_M_SPIN_ARM    0.08
Q_M_SPIN_MIN    0.12
Q_M_SPIN_MAX    0.95
Q_M_THST_HOVER  0.6
Q_M_HOVER_LEARN 2

# forward flight. The sim.js wing stalls near 13.6 m/s at 1,989 g (CL max about 0.87), above the 11.5-12 m/s the
# vortex-lattice study gives; these speeds follow the sim so transitions finish with margin. Revisit after a glide test.
AIRSPEED_MIN    16
AIRSPEED_CRUISE 18
AIRSPEED_MAX    24
AIRSPEED_STALL  14
ARSPD_TYPE      0
Q_ASSIST_SPEED  15
Q_TRANSITION_MS 6000
MIXING_GAIN     0.5
KFF_RDDRMIX     0

# landing gear: up above 8 m, down below 5 m
LGR_DEPLOY_ALT  5
LGR_RETRACT_ALT 8

# learn the tail trims in level flight
SERVO_AUTO_TRIM 1

# Hover yaw comes only from the nozzle swing, which is weak against the fins in wind (SITL: 3 m/s turns the nose
# into the wind against 10-12 of the 20 deg swing). Let the autopilot weathervane into the wind on purpose instead.
Q_WVANE_ENABLE  1
Q_WVANE_GAIN    1

# legs down when the board powers up
LGR_STARTUP     2
